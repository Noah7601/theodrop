<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Filee.App.ViewModels.Pages"
             xmlns:c="using:Filee.App.Controls"
             xmlns:v="using:Filee.App.Views"
             x:Class="Filee.App.Views.Pages.AboutPage"
             x:DataType="vm:AboutPageViewModel">
  <StackPanel Spacing="18">
    <TextBlock Classes="h1" Text="{DynamicResource about.title}" />
    <Border Classes="card">
      <StackPanel Orientation="Horizontal" Spacing="18">
        <Image Source="avares://Filee/Assets/Icons/theodrop.png" Width="72" Height="72" />
        <StackPanel VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="TheoDrop" FontSize="24" FontWeight="Bold" />
          <TextBlock Classes="muted" Text="{Binding Version}" />
          <TextBlock Classes="muted" Text="Based on Filee · MIT License" />
          <Button Classes="ghost" Padding="0" Click="OnOpenRepository" Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Link}" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding RepositoryUrl}" Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="h2" Text="Original Filee project" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="TheoDrop keeps Filee's MIT license and credits. Source, issues and sponsorship below go to the upstream project." />
        <WrapPanel>
          <Button Classes="accent" Click="OnStar" Margin="0,0,8,0" Content="Star Filee" />
          <Button Click="OnIssue" Content="Filee issues" Margin="0,0,8,0" />
          <Button Click="OnSponsor">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Width="13" Height="13" Data="{StaticResource Icon.Heart}" Foreground="#D4537E" />
              <TextBlock Text="Sponsor Filee" />
            </StackPanel>
          </Button>
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Classes="h2" Text="{DynamicResource about.notices}" />
        <c:MarkdownView Markdown="{Binding Notices}" SkipTitle="True" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
